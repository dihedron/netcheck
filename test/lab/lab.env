# shellcheck shell=bash disable=SC2034 # settings, read by lab.sh
# Settings of the netcheck lab (see .specs/netcheck-lab.md). To change one for a
# single machine, set it in lab.local.env next to this file (git-ignored); to
# change it for one command, set it in the environment. The environment wins
# over lab.local.env, which wins over this file.

# Image of the VMs.
LAB_IMAGE="ubuntu:24.04"
# The LXD project, the two networks and the storage pool the lab creates; all
# carry user.netcheck-lab=yes.
LAB_PROJECT="netcheck-lab"
LAB_POOL="netcheck-lab"
LAB_POOL_DRIVER="dir"
# The client's network (NAT to the outside) and the servers' network, behind
# the router; /24 prefixes, the gateway is .1, the router .2.
LAB_NET_CLIENT="nclab"
LAB_NET_SERVERS="ncsrv"
LAB_SUBNET_CLIENT="10.77.0"
LAB_SUBNET_SERVERS="10.78.0"
# Host part of the VMs' addresses.
LAB_HOST_CLIENT=10
LAB_HOST_SERVERS=10
LAB_HOST_FW=2
# Sizes.
LAB_CLIENT_CPUS=4
LAB_CLIENT_MEMORY="2GiB"
LAB_SERVERS_CPUS=2
LAB_SERVERS_MEMORY="2GiB"
LAB_FW_CPUS=1
LAB_FW_MEMORY="512MiB"
# The package under test: empty means the newest netcheck_*_linux_amd64.deb in
# dist/ (make snapshot builds it).
LAB_DEB=""
# The soak: hours, and the hours of the day in which it refuses to start
# without --now (AGENTS.md rule 14).
LAB_SOAK_HOURS=8
LAB_DAY_START=8
LAB_DAY_END=20
